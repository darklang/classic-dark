#!/usr/bin/env bash

set -euo pipefail

for name in "${@}"; do
  if [[ $name == postgresql ]]; then

    # When rebuilding the docker container (esp between ubuntu versions), the
    # postgres user may have a different userid, so fix up the existing volume
    sudo chown -R postgres:postgres /etc/postgresql
    sudo chown -R postgres:postgres /var/log/postgresql
    sudo chown -R postgres:postgres /var/lib/postgresql

    # If upgrading from PG 13 to 16, or if the data dir is missing/corrupt,
    # clean out and create a fresh PG 16 cluster.
    if [ ! -f /var/lib/postgresql/16/main/PG_VERSION ]; then
      echo "No valid PG 16 data directory found, creating fresh cluster"
      sudo rm -rf /etc/postgresql/13 /var/lib/postgresql/13
      sudo rm -rf /etc/postgresql/16 /var/lib/postgresql/16
      # setsid runs initdb in a new session so SIGHUP from the devcontainer
      # startup process group doesn't kill the temporary postgres subprocess
      sudo setsid pg_createcluster 16 main -- --nosync

      # Recreate the dark user and databases (normally done in Dockerfile,
      # but lost when we recreate the cluster from a stale volume)
      sudo pg_ctlcluster 16 main start
      sudo -u postgres psql --command "CREATE USER dark WITH SUPERUSER PASSWORD 'darklang';"
      sudo -u postgres createdb -O dark devdb
      sudo -u postgres createdb -O dark testdb
      sudo pg_ctlcluster 16 main stop
    fi

    # Ensure remote connections and listen address are configured
    # (Dockerfile sets these at build time, but cluster recreation loses them)
    if ! grep -q "host all  all    0.0.0.0/0" /etc/postgresql/16/main/pg_hba.conf 2>/dev/null; then
      echo "host all  all    0.0.0.0/0  md5" | sudo tee -a /etc/postgresql/16/main/pg_hba.conf
    fi
    LA="listen_addresses = '*'"
    echo "$LA" | sudo tee -a /etc/postgresql/16/main/postgresql.conf

    # Fix weird permission problem, see from https://github.com/puntonim/docker-postgresql93/issues/2
    sudo chmod 766 /etc/ssl/private
    sudo chown postgres:postgres /etc/ssl/private/ssl-cert-snakeoil.key
    sudo mkdir /etc/ssl/private-copy
    sudo mv /etc/ssl/private/* /etc/ssl/private-copy/
    sudo rm -r /etc/ssl/private
    sudo mv /etc/ssl/private-copy /etc/ssl/private
    sudo chmod -R 0700 /etc/ssl/private
    sudo chown -R postgres /etc/ssl/private
  fi

  echo "--------------------------"
  echo "--  Starting $name"
  echo "--------------------------"
  sudo service "$name" start

done


