[expected-request]
GET PATH HTTP/1.1
Accept: */*
Accept-Encoding: deflate, gzip, br
Content-Type: text/plain; charset=utf-8
Host: HOST

[response]
HTTP/1.1 303 See Other
Date: xxx, xx xxx xxxx xx:xx:xx xxx
Location: https://httpbin.org/status/200



[test]
(let response = HttpClient.get_v5_ster "http://URL" {} {}
 let respHeaders = response.headers |> Dict.filterMap_v0 (fun (key, value) -> if List.member_v0 ["HTTP/1.1 303 See Other"; "Date"; "Location"; "Server"; "Transfer-Encoding"; "HTTP/2 200"; "access-control-allow-credentials"; "access-control-allow-origin"; "content-length"; "content-type"] key then Just value else Nothing) in
 Dict.set_v0 response "headers" respHeaders) =
    { body = ""
      code = 200
      error = ""
      headers =
        {
          ``access-control-allow-credentials`` = "true"
          ``access-control-allow-origin`` = "*"
          ``content-type`` = "text/html; charset=utf-8"
          ``content-length`` = "0"
          ``Date`` = "xxx, xx xxx xxxx xx:xx:xx xxx"
          ``HTTP/2 200`` = ""
          ``HTTP/1.1 303 See Other`` = ""
          Location = "https://httpbin.org/status/200"
          Server = "Kestrel"
          ``Transfer-Encoding`` = "chunked"
        }
      raw = ""
    }
